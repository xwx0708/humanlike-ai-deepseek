# 复制为 .env 后按需修改。.env 不进版本库。环境变量优先于 .env。

# ---- 两个角色各用哪家、哪个模型，可以随意搭配 ----
# 提供方可选：openai_compat（任何 OpenAI 兼容接口）、deepseek、ollama
THINKING_PROVIDER=deepseek
THINKING_MODEL=deepseek-flash        # 也可以用 deepseek-v4-pro
THINKING_CONTEXT_LIMIT=128000        # 思考模型的上下文上限（token），熟悉期用到 70% 启动记忆系统；按实际模型核实
SUBCONSCIOUS_PROVIDER=ollama
SUBCONSCIOUS_MODEL=qwen3.8:27b-q4_K_M

# ---- 通用 OpenAI 兼容接口（提供方选 openai_compat 时用）----
# 例：https://api.deepseek.com、https://dashscope.aliyuncs.com/compatible-mode/v1、http://127.0.0.1:8000/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- DeepSeek 的连接设置 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false              # true：先思考再回答，更慢、更费 token

# ---- Ollama 的连接设置 ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m                # 空闲多久后卸载模型
OLLAMA_NUM_CTX=16384                 # 上下文长度；3090 加载 Qwen 27B 后约剩 7GB 显存

# ---- Docker 一键部署（docker compose，见 03-回应/部署.md）----
OWNER_QQ=                            # 只陪的那个人的 QQ 号（D29）；其他人和群聊一律不回
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434   # 容器里访问宿主机 Ollama 的地址，一般不用改
