# 复制为 .env 后按需修改。.env 不进版本库。环境变量优先于 .env。

# 思考模型：DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash        # 可选 deepseek-v4-pro
DEEPSEEK_THINKING=false              # true：先思考再回答，更慢、更费 token

# 潜意识模型：本地 Ollama 上的 Qwen
OLLAMA_MODEL=qwen3.8:27b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30m                # 空闲多久后卸载模型
OLLAMA_NUM_CTX=16384                 # 上下文长度；3090 加载模型后约剩 7GB 显存
